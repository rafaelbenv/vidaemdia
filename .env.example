# ==========================================
# VIDAEMDIA - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================

# Banco de Dados (PostgreSQL)
POSTGRES_USER=vidaemdia
POSTGRES_PASSWORD=vidaemdia_secret_pwd
POSTGRES_DB=vidaemdia_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://vidaemdia:vidaemdia_secret_pwd@localhost:5432/vidaemdia_db?schema=public"

# Backend (NestJS)
PORT=3000
NODE_ENV=development
JWT_SECRET="vidaemdia_jwt_super_secret_key_2026"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
TZ="America/Sao_Paulo"
APP_TIMEZONE="America/Sao_Paulo"

# Worker de Notificações
WORKER_CRON_EXPRESSION="*/1 * * * *" # Executa a cada 1 minuto (ou */5 * * * * para 5 min)
MAX_REMINDER_RETRIES=3

# Integração WhatsApp Business API (Meta Cloud API / Evolution API)
WHATSAPP_ENABLED=false
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_PHONE_NUMBER_ID="000000000000"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_cloud_api_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="vidaemdia_wa_verify_token"

# Integração Telegram Bot API
TELEGRAM_ENABLED=true
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN="000000000:AAH_your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="seu_bot_username"
TELEGRAM_WEBHOOK_URL="https://seu-dominio.com/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET="uma_string_aleatoria_segura"

# Monitoramento (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=vidaemdia_admin

