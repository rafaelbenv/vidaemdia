# ==========================================
# VIDAEMDIA - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================

# Banco de Dados (PostgreSQL)
POSTGRES_USER=vidaemdia
# Obrigatório. Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vidaemdia_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://vidaemdia:troque-esta-senha@localhost:5432/vidaemdia_db?schema=public"

# Backend (NestJS)
PORT=3000
NODE_ENV=development
# Obrigatório. Gere com: openssl rand -hex 32
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRES_IN="8h"
# Opcional. Só preencha se o front rodar em outro endereço que não passe pelo /api (ex.: http://localhost:5173). Vários: separados por vírgula.
CORS_ORIGIN=""
TZ="America/Sao_Paulo"
APP_TIMEZONE="America/Sao_Paulo"

# Worker de Notificações
WORKER_CRON_EXPRESSION="*/1 * * * *" # Executa a cada 1 minuto (ou */5 * * * * para 5 min)
MAX_REMINDER_RETRIES=3

# Integração Telegram Bot API
TELEGRAM_ENABLED=true
TELEGRAM_MODE=mock
TELEGRAM_BOT_TOKEN="000000000:AAH_your_telegram_bot_token"
TELEGRAM_BOT_USERNAME="seu_bot_username"
TELEGRAM_WEBHOOK_URL="https://seu-dominio.com/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET="uma_string_aleatoria_segura"

# Google Agenda (opcional)
# Para obter credenciais: Google Cloud Console → APIs e Serviços → Credenciais → Criar credenciais → ID do cliente OAuth (tipo Aplicativo da Web).
# URIs de redirecionamento autorizados: http://localhost:8080/api/google/callback (produção/proxy) e http://localhost:3000/google/callback (dev local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/google/callback"
# Chave de 32 bytes (64 caracteres hexadecimais) para criptografar tokens. Obrigatória se GOOGLE_CLIENT_ID estiver configurado. Gere com: openssl rand -hex 32
GOOGLE_TOKEN_ENC_KEY=""
FRONTEND_URL="http://localhost:8080"

# Monitoramento (Grafana)
GRAFANA_ADMIN_USER=admin
# Obrigatório. Gere com: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Opcional. URL pública do Grafana atrás do reverse proxy (padrão: http://localhost:8080/grafana/)
# GRAFANA_ROOT_URL=http://localhost:8080/grafana/

